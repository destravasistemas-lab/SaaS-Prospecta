# PostgreSQL
DATABASE_URL=postgresql+asyncpg://marketing_user:marketing_pass@localhost:5432/adstudioai

# Meta / Facebook Graph API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_API_VERSION=v21.0
META_REDIRECT_URI=http://localhost:8000/api/v1/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# WhatsApp Embedded Signup — crie em:
# Meta App Dashboard > WhatsApp > Configuração > Embedded Signup > Configurations
WHATSAPP_CONFIG_ID=your_whatsapp_embedded_signup_config_id

# Token encryption (Fernet) — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# n8n event dispatching (optional — leave blank to log only)
N8N_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Supabase Storage — mídias de post do Instagram (disco do Fly é efêmero!)
# ---------------------------------------------------------------------------
# Crie um bucket PÚBLICO no Supabase (Storage > New bucket > Public) e cole aqui.
# A service_role key está em: Supabase > Project Settings > API > service_role.
# Se ficar em branco, cai no fallback de disco local (só serve para dev).
SUPABASE_URL=https://SEU_REF.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_BUCKET=post-media

# Sync da Marketing API a cada 10 min (campanhas, conjuntos, anúncios e insights)
ADS_SYNC_ENABLED=false

# Chamadas de voz do WhatsApp (assine também o campo "calls" do webhook no app da Meta)
WHATSAPP_CALLING_ENABLED=false
# Opcional: iceServers do navegador em JSON, ex. [{"urls":"turn:turn.exemplo.com:443","username":"u","credential":"s"}]
WEBRTC_ICE_SERVERS=
# true com mais de uma instância da API: entrega os eventos do WebSocket pelo Redis
WS_REDIS_FANOUT=false

# Janela máxima para agendar um post no futuro (dias)
MAX_SCHEDULE_DAYS=15

# Security
SECRET_KEY=change_this_to_a_random_secret_key
CORS_ORIGINS=["http://localhost:5173"]

# Super admins do sistema (emails separados por vírgula). Podem bloquear/
# liberar módulos (whatsapp, instagram, ads, ia) de QUALQUER conta — as
# agências fazem o mesmo só com as empresas-filhas (plan_type "dependente").
SUPER_ADMIN_EMAILS=admin@suaempresa.com

# ---------------------------------------------------------------------------
# IA de atendimento (Gemini 2.5 Flash + RAG)
# ---------------------------------------------------------------------------
# Redis — debounce da IA, rate limit anti-loop e dedup de webhook.
# No docker-compose já é injetado (redis://redis:6379/0). Vazio = fallback
# em memória (ok em 1 processo; use Redis em produção/multi-worker).
REDIS_URL=redis://redis:6379/0

# IA do Prospecta: chaves da Gemini da plataforma, separadas por vírgula.
# Cada conta usa a franquia do plano (atendimentos/mês) sem configurar nada.
# Quem preferir pode colar a própria chave no painel (IA e conhecimento);
# ela fica criptografada com a FERNET_KEY e não entra na franquia.
GEMINI_API_KEYS=
# Vazão: requisições/min por chave e por conta, espera máxima na fila (s)
# e pausa da chave que recebeu 429 (s)
AI_KEY_RPM=500
AI_ACCOUNT_RPM=20
AI_SLOT_WAIT_SECONDS=25
AI_KEY_COOLDOWN_SECONDS=30
# Preço: tokens médios por atendimento, preço do modelo (US$/1M) e câmbio
AI_TOKENS_PER_CONVERSATION=20000
AI_PRICE_INPUT_USD_PER_M=0.30
AI_PRICE_OUTPUT_USD_PER_M=2.50
USD_BRL=5.60
# Atendimentos com a IA do Prospecta durante o teste grátis
AI_TRIAL_CONVERSATIONS=100
# Pacote extra vendido por Pix (atendimentos e preço em centavos)
AI_PACK_CONVERSATIONS=500
AI_PACK_PRICE_CENTS=4900

# Defaults de comportamento da IA (opcionais — já têm valor no código)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMS=768
AI_DEBOUNCE_SECONDS=3
AI_REQUEST_TIMEOUT=10
AI_DEFAULT_TOKEN_LIMIT=1000000

# ---------------------------------------------------------------------------
# Posts do Instagram: limites por empresa sem plano (o plano manda quando tem)
# ---------------------------------------------------------------------------
DEFAULT_SCHEDULED_POSTS=30
DEFAULT_STORAGE_MB=500
DEFAULT_AUTOMATIONS=20
# Automação de post desliga sozinha depois destes dias sem alteração (0 = nunca)
POST_AUTOMATION_DAYS=30
# Mídia de post que falhou é apagada depois destes dias
FAILED_MEDIA_DAYS=7
